# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate new one with: openssl rand -base64 32>

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=<from GCP Credentials>
GOOGLE_CLIENT_SECRET=<from GCP Credentials>

# Firebase Configuration (server-only — Admin SDK)
# Generate a service account key in Firebase Console > Project Settings >
# Service Accounts > Generate new private key, then paste the full JSON as a
# single-line string here.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

